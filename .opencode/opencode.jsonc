{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llamacpp-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local, managed)",
      "options": {
        // Must be explicitly true or this provider (and llama-server autospawn) stays off,
        // even with this block present — set to false when you want cloud-only for a session.
        "enabled": true,
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "not-needed",
        "headerTimeout": 1800000,
        "chunkTimeout": 1800000,
        "binaryPath": "/home/methodwhite/.local/bin/llama-server"
      },
      "models": {
        "Qwen3.5-9B-Abliterated-HSAQR-General.Q4_K_M.gguf": {
          "name": "Qwen 3.5 9B Abliterated HSAQR-General (local, uncensored)",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "options": {
            "baseURL": "http://127.0.0.1:8083/v1",
            "port": 8083,
            "modelPath": "/home/methodwhite/.cache/models/gguf/Qwen3.5-9B-Abliterated-HSAQR-General.Q4_K_M.gguf",
            "contextLength": 32768,
            "binaryPath": "/home/methodwhite/.local/bin/llama-server-cuda",
            "flashAttention": true,
            "fit": true,
            "fitTargetMiB": 512,
            "reasoning": false
          }
        }
      }
    }
  },
  "permission": {},
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  "mcp": {},
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
